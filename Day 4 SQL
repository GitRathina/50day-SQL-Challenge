/*
Find the top 2 products in the top 2 categories based on spend amount?
*/

-- top 2 category based on spend 
-- top 2 product in above best 2 category

select * from orders_1


With ranked_category
AS (
select * from (
select category, sum(spend), dense_rank() over (order by sum(spend) desc) as category_rank

from orders_1 

group by category

) where category_rank<=2
)


select * from
(
select o.category, o.product, dense_rank()over (partition by o.category order by sum(o.spend) desc) as product_rank

from orders_1 as o
join ranked_category as rc
on rc.category = o.category

group by o.category, o.product

) where product_rank <=2



